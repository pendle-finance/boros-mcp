{
  "name": "@pendle/boros-mcp",
  "version": "0.1.7",
  "description": "MCP server for Boros — Pendle's interest rate derivatives trading platform",
  "type": "module",
  "bin": "./dist/index.js",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc && cp -r src/pages dist/pages",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "yarn npm publish",
    "prepack": "yarn build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "boros",
    "pendle",
    "trading",
    "interest-rate-swaps"
  ],
  "license": "MIT",
  "homepage": "https://github.com/pendle-finance/boros-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pendle-finance/boros-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/pendle-finance/boros-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.0",
    "open": "^10.1.0",
    "viem": "^2.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@4.13.0"
}
